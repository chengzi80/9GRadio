<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ─── RF / Tuner ─────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_rf_tuner_title" android:key="cat_rf">

        <ListPreference
            android:key="pref_sample_rate"
            android:title="@string/pref_default_sample_rate_title"
            android:summary="@string/pref_default_sample_rate_summary"
            android:defaultValue="1920000"
            android:dialogTitle="Select Sample Rate"
            android:entries="@array/sample_rate_entries"
            android:entryValues="@array/sample_rate_values"/>

        <SeekBarPreference
            android:key="pref_ppm"
            android:title="@string/pref_ppm_correction_title"
            android:summary="@string/pref_frequency_offset_summary"
            android:defaultValue="0"
            app:min="-50"
            android:max="50"
            app:showSeekBarValue="true"/>

        <ListPreference
            android:key="pref_default_demod"
            android:title="@string/pref_default_demod_title"
            android:summary="@string/pref_mode_startup_summary"
            android:defaultValue="NFM"
            android:dialogTitle="Select Demodulation Mode"/>

        <SwitchPreferenceCompat
            android:key="pref_tuner_agc_default"
            android:title="@string/pref_tuner_agc_default_title"
            android:summary="@string/pref_tuner_agc_default_summary"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_hardware_agc_default"
            android:title="@string/pref_hardware_agc_default_title"
            android:summary="@string/pref_hardware_agc_default_summary"
            android:defaultValue="false"/>

        <SeekBarPreference
            android:key="pref_default_gain"
            android:title="@string/pref_default_gain_title"
            android:summary="@string/pref_default_gain_summary"
            android:defaultValue="26"
            app:min="0"
            android:max="28"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_squelch_default"
            android:title="@string/pref_default_squelch_title"
            android:summary="@string/pref_default_squelch_summary"
            android:defaultValue="100"
            app:min="0"
            android:max="120"
            app:showSeekBarValue="true"/>
    </PreferenceCategory>

    <!-- ─── 9GRadio Hardware Specific ──────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_hardware_features" android:key="cat_v4">

        <SwitchPreferenceCompat
            android:key="pref_bias_tee_default"
            android:title="@string/pref_bias_tee_default_title"
            android:summary="@string/pref_bias_tee_summary"
            android:defaultValue="false"/>

        <ListPreference
            android:key="pref_direct_sampling_default"
            android:title="@string/pref_direct_sampling_title"
            android:summary="@string/pref_direct_sampling_summary"
            android:entries="@array/direct_sampling_entries"
            android:entryValues="@array/direct_sampling_values"
            android:defaultValue="0"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_hf"
            android:title="@string/pref_auto_switch_hf_title"
            android:summary="@string/pref_auto_switch_hf_summary"
            android:defaultValue="true"/>

        <EditTextPreference
            android:key="pref_tcxo_freq"
            android:title="@string/pref_xtal_title"
            android:summary="@string/pref_xtal_summary"
            android:defaultValue="28800000"
            android:inputType="number"/>
    </PreferenceCategory>

    <!-- ─── Display ───────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_display_title" android:key="cat_display">

        <ListPreference
            android:key="pref_fft_size"
            android:title="@string/pref_fft_size_title"
            android:summary="@string/pref_fft_size_summary"
            android:entries="@array/fft_size_entries"
            android:entryValues="@array/fft_size_values"
            android:defaultValue="256"/>

        <ListPreference
            android:key="pref_decimation"
            android:title="@string/pref_fft_decimation_title"
            android:summary="@string/pref_fft_decimation_summary"
            android:entries="@array/decimation_entries"
            android:entryValues="@array/decimation_values"
            android:defaultValue="64"
            android:dialogTitle="Select Decimation Factor"/>

        <ListPreference
            android:key="pref_fft_window"
            android:title="@string/pref_fft_window_title"
            android:summary="@string/pref_fft_window_summary"
            android:entries="@array/fft_window_entries"
            android:entryValues="@array/fft_window_values"
            android:defaultValue="BLACKMAN_HARRIS"/>

        <SeekBarPreference
            android:key="pref_fft_smoothing"
            android:title="@string/pref_fft_smoothing_title"
            android:summary="@string/pref_fft_smoothing_summary"
            android:defaultValue="30"
            app:min="0"
            android:max="95"
            app:showSeekBarValue="true"/>

        <ListPreference
            android:key="pref_spectrum_theme"
            android:title="@string/pref_spectrum_theme_title"
            android:entries="@array/spectrum_theme_entries"
            android:entryValues="@array/spectrum_theme_values"
            android:defaultValue="Futuristic"/>

        <ListPreference
            android:key="pref_waterfall_palette"
            android:title="@string/pref_waterfall_palette_title"
            android:entries="@array/waterfall_palette_entries"
            android:entryValues="@array/waterfall_palette_values"
            android:defaultValue="RAINBOW"/>

        <SeekBarPreference
            android:key="pref_waterfall_speed"
            android:title="@string/pref_waterfall_speed_title"
            android:summary="@string/pref_waterfall_speed_summary"
            android:defaultValue="25"
            app:min="1"
            android:max="60"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_peak_hold"
            android:title="@string/pref_peak_hold_title"
            android:summary="@string/pref_peak_hold_summary"
            android:defaultValue="true"/>

        <SeekBarPreference
            android:key="pref_db_min"
            android:title="@string/pref_spectrum_floor_title"
            android:summary="@string/pref_spectrum_floor_summary"
            android:defaultValue="120"
            app:min="60"
            android:max="150"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_db_max"
            android:title="@string/pref_spectrum_ceiling_title"
            android:summary="@string/pref_spectrum_ceiling_summary"
            android:defaultValue="0"
            app:min="-40"
            android:max="0"
            app:showSeekBarValue="true"/>

        <!-- ── Advanced spectrum / waterfall controls ───────────────── -->

        <ListPreference
            android:key="pref_frame_averaging"
            android:title="@string/pref_frame_averaging_title"
            android:summary="@string/pref_frame_averaging_summary"
            android:entries="@array/frame_avg_entries"
            android:entryValues="@array/frame_avg_values"
            android:defaultValue="1"
            android:dialogTitle="Select Frame Averaging"/>

        <SeekBarPreference
            android:key="pref_peak_decay"
            android:title="@string/pref_peak_decay_title"
            android:summary="@string/pref_peak_decay_summary"
            android:defaultValue="2"
            app:min="1"
            android:max="20"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_show_noise_floor"
            android:title="@string/pref_noise_floor_line_title"
            android:summary="@string/pref_noise_floor_line_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_show_peak_annotations"
            android:title="@string/pref_peak_labels_title"
            android:summary="@string/pref_peak_labels_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_crosshair_enabled"
            android:title="@string/pref_touch_crosshair_title"
            android:summary="@string/pref_touch_crosshair_summary"
            android:defaultValue="true"/>

        <SeekBarPreference
            android:key="pref_fill_opacity"
            android:title="@string/pref_spectrum_fill_title"
            android:summary="@string/pref_spectrum_fill_summary"
            android:defaultValue="73"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_range"
            android:title="@string/pref_auto_db_title"
            android:summary="@string/pref_auto_db_summary"
            android:defaultValue="false"/>

        <SeekBarPreference
            android:key="pref_waterfall_brightness"
            android:title="@string/pref_waterfall_brightness_title"
            android:summary="@string/pref_waterfall_brightness_summary"
            android:defaultValue="50"
            app:min="0"
            android:max="100"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_waterfall_contrast"
            android:title="@string/pref_waterfall_contrast_title"
            android:summary="@string/pref_waterfall_contrast_summary"
            android:defaultValue="50"
            app:min="5"
            android:max="150"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_waterfall_auto_stretch"
            android:title="@string/pref_waterfall_autostretch_title"
            android:summary="@string/pref_waterfall_autostretch_summary"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_waterfall_show_timestamp"
            android:title="@string/pref_waterfall_ruler_title"
            android:summary="@string/pref_waterfall_ruler_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_waterfall_show_tuner_marker"
            android:title="@string/pref_waterfall_centre_title"
            android:summary="@string/pref_waterfall_centre_summary"
            android:defaultValue="true"/>
    </PreferenceCategory>

    <!-- ─── Audio ─────────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_audio_title" android:key="cat_audio">

        <ListPreference
            android:key="pref_audio_output"
            android:title="@string/pref_audio_output_title"
            android:entries="@array/audio_output_entries"
            android:entryValues="@array/audio_output_values"
            android:defaultValue="speaker"/>

        <ListPreference
            android:key="pref_audio_sink_rate"
            android:title="@string/pref_audio_rate_title"
            android:summary="@string/pref_audio_rate_summary"
            android:entries="@array/audio_sink_rate_entries"
            android:entryValues="@array/audio_sink_rate_values"
            android:defaultValue="44100"
            android:dialogTitle="Select Audio Output Rate"/>

        <SeekBarPreference
            android:key="pref_default_volume"
            android:title="@string/pref_default_volume_title"
            android:summary="0–200%"
            android:defaultValue="100"
            app:min="0"
            android:max="200"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_stereo_wfm"
            android:title="@string/pref_wfm_stereo_title"
            android:summary="@string/pref_wfm_stereo_summary"
            android:defaultValue="true"/>

        <SeekBarPreference
            android:key="pref_deemph_us"
            android:title="@string/pref_fm_deemphasis_title"
            android:summary="@string/pref_fm_deemphasis_summary"
            android:defaultValue="75"
            app:min="50"
            android:max="75"
            app:showSeekBarValue="true"/>

        <ListPreference
            android:key="pref_freq_offset"
            android:title="@string/pref_frequency_offset_title"
            android:summary="@string/pref_frequency_offset_summary2"
            android:entries="@array/freq_offset_entries"
            android:entryValues="@array/freq_offset_values"
            android:defaultValue="0"/>

        <SwitchPreferenceCompat
            android:key="pref_dc_block"
            android:title="@string/pref_dc_block_title"
            android:summary="@string/pref_dc_block_summary"
            android:defaultValue="true"/>

    </PreferenceCategory>

    <!-- ─── External Decoder ──────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_external_decoder_title" android:key="cat_external_decoder">

        <SwitchPreferenceCompat
            android:key="pref_external_decoder_enabled"
            android:title="@string/pref_external_decoder_enabled_title"
            android:summary="@string/pref_external_decoder_enabled_summary"
            android:defaultValue="false"/>

        <EditTextPreference
            android:key="pref_external_decoder_host"
            android:title="@string/pref_destination_host_title"
            android:summary="@string/pref_destination_host_summary"
            android:defaultValue="127.0.0.1"/>

        <EditTextPreference
            android:key="pref_external_decoder_port"
            android:title="@string/pref_destination_port_title"
            android:summary="@string/pref_destination_port_summary"
            android:defaultValue="7355"
            android:inputType="number"/>

    </PreferenceCategory>

    <!-- ─── Recording ─────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_recording_title" android:key="cat_recording">

        <ListPreference
            android:key="pref_iq_format"
            android:title="@string/pref_iq_format_title"
            android:entries="@array/iq_format_entries"
            android:entryValues="@array/iq_format_values"
            android:defaultValue="RAW_UINT8"/>

        <EditTextPreference
            android:key="pref_recording_path"
            android:title="@string/pref_recording_dir_title"
            android:summary="@string/pref_recording_dir_summary"
            android:defaultValue="RTL-SDR/Recordings"
            android:inputType="text"/>

        <SeekBarPreference
            android:key="pref_max_recording_gb"
            android:title="@string/pref_max_recording_title"
            android:summary="@string/pref_max_recording_summary"
            android:defaultValue="4"
            app:min="1"
            android:max="64"
            app:showSeekBarValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_split_recordings"
            android:title="@string/pref_split_recording_title"
            android:summary="@string/pref_split_recording_summary"
            android:defaultValue="true"/>

        <Preference
            android:key="pref_clear_recordings"
            android:title="@string/pref_clear_recordings_title"
            android:summary="@string/pref_clear_recordings_summary"/>
    </PreferenceCategory>

    <!-- ─── Scanner ───────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_scanner_defaults_title" android:key="cat_scanner">

        <SeekBarPreference
            android:key="pref_scan_dwell_ms"
            android:title="@string/pref_dwell_time_title"
            android:summary="@string/pref_dwell_time_summary"
            android:defaultValue="200"
            app:min="50"
            android:max="5000"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_scan_resume_s"
            android:title="@string/pref_resume_delay_title"
            android:summary="@string/pref_resume_delay_summary"
            android:defaultValue="3"
            app:min="1"
            android:max="30"
            app:showSeekBarValue="true"/>

        <SeekBarPreference
            android:key="pref_scan_squelch"
            android:title="@string/pref_scan_squelch_title"
            android:summary="@string/pref_scan_squelch_summary"
            android:defaultValue="80"
            app:min="20"
            android:max="120"
            app:showSeekBarValue="true"/>
    </PreferenceCategory>

    <!-- ─── Data / Backup ─────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_data_backup_title" android:key="cat_data">

        <Preference
            android:key="pref_export_settings"
            android:title="@string/pref_export_settings_title"
            android:summary="@string/pref_export_settings_summary"/>

        <Preference
            android:key="pref_import_settings"
            android:title="@string/pref_import_settings_title"
            android:summary="@string/pref_import_settings_summary"/>

        <Preference
            android:key="pref_export_memory"
            android:title="@string/pref_export_memory_title"
            android:summary="@string/pref_export_memory_summary"/>

        <Preference
            android:key="pref_import_memory"
            android:title="@string/pref_import_memory_title"
            android:summary="@string/pref_import_memory_summary"/>
    </PreferenceCategory>

    <!-- ─── About ─────────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_about_title" android:key="cat_about">

        <Preference
            android:key="pref_about"
            android:title="@string/pref_about_app"
            android:summary=""/>

        <Preference
            android:key="pref_device_info"
            android:title="@string/pref_device_info_title"
            android:summary="@string/pref_device_info_summary"/>

        <SwitchPreferenceCompat
            android:key="pref_keep_screen_on"
            android:title="@string/pref_keep_screen_on_title"
            android:summary="@string/pref_keep_screen_on_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_wake_lock"
            android:title="@string/pref_prevent_cpu_sleep_title"
            android:summary="@string/pref_prevent_cpu_sleep_summary"
            android:defaultValue="false"/>
    </PreferenceCategory>

    <!-- ─── APRS ──────────────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_aprs_title" android:key="cat_aprs">

        <SwitchPreferenceCompat
            android:key="pref_aprs_auto_display"
            android:title="@string/pref_aprs_autodisplay_title"
            android:summary="@string/pref_aprs_autodisplay_summary"
            android:defaultValue="true"/>

    </PreferenceCategory>

</PreferenceScreen>
