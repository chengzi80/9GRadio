<?xml version="1.0" encoding="utf-8"?>
<!-- Tab – Scan: embedded frequency scanner. Hidden by default; shown only
     when explicitly invoked (Scanner button / FAB), same pattern as the
     APRS/ACARS/DMR/YSF/D-STAR/Dig protocol tabs but triggered on demand
     instead of by DemodMode. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- Section label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scanner"
        android:textColor="#00CCFF"
        android:textSize="13sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <!-- Scanner details toggle header. The detail fields below are collapsed
         by default; tapping this row expands/collapses them. -->
    <LinearLayout android:id="@+id/rowScanTabDetailsToggle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:clickable="true" android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingVertical="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/scan_details"
            android:textColor="#AAFFFFFF" android:textSize="12sp"
            android:textAllCaps="true" android:letterSpacing="0.05"/>
        <TextView android:id="@+id/tvScanTabDetailsChevron"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&#9656;"
            android:textColor="#AAFFFFFF" android:textSize="14sp"/>
    </LinearLayout>

    <!-- Collapsible container: everything the user needs to configure before
         starting a scan. Collapsed (GONE) by default; expanded on demand via
         rowScanTabDetailsToggle so the tab opens compact. -->
    <LinearLayout android:id="@+id/llScanTabDetails"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/scan_start_mhz"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginEnd="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScanTabStart"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:text="136.0"
                android:textColor="#FFFFFF" android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/scan_stop_mhz"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScanTabStop"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:text="174.0"
                android:textColor="#FFFFFF" android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/scan_step_hz"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginEnd="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScanTabStep"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:text="12500"
                android:textColor="#FFFFFF" android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/scan_squelch_db"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScanTabSquelch"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberSigned" android:text="-80"
                android:textColor="#FFFFFF" android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="@string/scan_dwell_ms"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginEnd="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etScanTabDwell"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:text="200"
                android:textColor="#FFFFFF" android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Spinner android:id="@+id/spinnerScanTabMode"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:backgroundTint="#00CCFF"/>
    </LinearLayout>

    <!-- Scan direction switch -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/scan_direction_down"
            android:textColor="#AAFFFFFF" android:textSize="12sp"/>
        <Switch android:id="@+id/switchScanTabDirection"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <!-- Standard scanner "hold" behaviour: stay on a hit and keep playing
             audio for as long as the carrier is present, only resuming the
             sweep after the signal actually drops (matches how SDRangel's
             channel demodulators stay locked to an active signal rather than
             timing out on a fixed dwell), instead of always resuming after a
             fixed resumeTimeMs regardless of whether the transmission is
             still going. Default ON since this is standard scanner behaviour. -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/scan_hold_on_signal" android:layout_marginStart="12dp"
            android:textColor="#AAFFFFFF" android:textSize="12sp"/>
        <Switch android:id="@+id/switchScanTabHoldOnSignal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checked="true"/>
    </LinearLayout>

    <!-- Adaptive squelch switch -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_adaptive_squelch"
            android:textColor="#AAFFFFFF" android:textSize="12sp"/>
        <Switch android:id="@+id/switchScanTabAdaptive"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checked="false"/>
    </LinearLayout>

    <!-- Scan parameter memory slots -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/scan_memory" android:textColor="#00CCFF" android:textSize="12sp"
            android:layout_marginEnd="8dp"/>
        <Spinner android:id="@+id/spinnerScanTabMemorySlot"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:backgroundTint="#00CCFF"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScanTabMemSave"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="@string/scan_save" android:textSize="11sp"
            android:backgroundTint="#2C3440" android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScanTabMemLoad"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="@string/scan_load" android:textSize="11sp"
            android:backgroundTint="#2C3440" android:textColor="#FFFFFF"/>
    </LinearLayout>

    </LinearLayout><!-- /llScanTabDetails -->

    <!-- Control buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp">
        <Button android:id="@+id/btnScanTabStartStop"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:text="@string/scan_start"
            android:textSize="12sp"
            android:backgroundTint="#00CC44" android:textColor="#000000"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScanTabReset"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:text="@string/scan_reset"
            android:textSize="12sp"
            android:backgroundTint="#2C3440" android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScanTabPause"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:text="@string/scan_pause"
            android:textSize="12sp"
            android:backgroundTint="#FFAA00" android:textColor="#000000"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnScanTabSearch"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="@string/scan_search_mode"
            android:textSize="11sp"
            android:backgroundTint="#7A5CFF" android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScanTabBusiest"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="@string/scan_busiest"
            android:textSize="11sp"
            android:backgroundTint="#2C3440" android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnScanTabClose"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:text="@string/scan_close"
            android:textSize="11sp"
            android:backgroundTint="#442222" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar android:id="@+id/progressScanTab"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:progressTint="#00CCFF" android:max="100"
        android:visibility="gone"/>

    <!-- Status -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/tvScanTabCurrentFreq"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="---"
            android:textColor="#00CCFF" android:textSize="14sp"
            android:fontFamily="monospace"/>
        <TextView android:id="@+id/tvScanTabSignal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--- dB" android:textColor="#44FF88"
            android:textSize="12sp" android:fontFamily="monospace"
            android:layout_marginEnd="12dp"/>
        <TextView android:id="@+id/tvScanTabHits"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/scan_hits_zero" android:textColor="#FFAA00"
            android:textSize="12sp" android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/tvScanTabNoiseFloor"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/scan_floor_unknown"
            android:textColor="#77AACCFF" android:textSize="11sp"
            android:fontFamily="monospace"/>
        <TextView android:id="@+id/tvScanTabRate"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--- ch/s" android:textColor="#77AACCFF"
            android:textSize="11sp" android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Tabulated channel view: one row per configured channel, refreshed
         in place with its latest power/activity every time the scan
         revisits it (as opposed to the hit log below, which only ever
         appends). Modeled on SDRangel's Frequency Scanner channel table. -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/scan_channel_table"
        android:textColor="#88FFFFFF" android:textSize="11sp"
        android:layout_marginTop="10dp" android:layout_marginBottom="4dp"/>

    <include layout="@layout/item_scan_channel_header"/>

    <ListView
        android:id="@+id/listScanTabChannelTable"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0D1117"
        android:divider="#22FFFFFF"
        android:dividerHeight="0.5dp"
        android:nestedScrollingEnabled="true"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/scan_active_frequencies"
        android:textColor="#88FFFFFF" android:textSize="11sp"
        android:layout_marginTop="10dp" android:layout_marginBottom="4dp"/>

    <!-- Hit log (fixed height inside the drawer's own scroll view) -->
    <ListView
        android:id="@+id/listScanTabHits"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0D1117"
        android:divider="#22FFFFFF"
        android:dividerHeight="0.5dp"
        android:nestedScrollingEnabled="true"/>

</LinearLayout>
